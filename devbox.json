{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    // Golang
    "go@latest",
    "gopls@latest",
    "go-tools@latest",
    "golangci-lint@latest",

    // Tasks
    "go-task@latest",
    "pre-commit@latest",
    "nix-update@latest",
    "gh@latest",
    "git-cliff@latest",
    // For tests
    "tparse@latest",
    // For e2e tests
    "qemu_full@latest",
    "cdrkit@latest", // For genisoimage
  ],
  "env": {
    "DEVBOX_NO_PROMPT": "true",
    "PANIX_CONFIG":     "examples/panix.deploy.yml",
  },
  "shell": {
    "init_hook": ["pre-commit autoupdate", "pre-commit install"],
    "scripts": {
      "test": ["echo \"Error: no test specified\" && exit 1"],
    },
  },
}
