{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    // Golang
    "go@latest",
    "gopls@latest",
    "go-tools@latest",
    "golangci-lint@latest",
    "govulncheck@latest",
    "gcc@latest",
    // Docs
    "bun@latest",
    // Tasks
    "go-task@latest",
    "pre-commit@latest",
    "nix-update@latest",
    "gh@latest",
    "git-cliff@latest",
    // Security
    "gitleaks@latest",
    // For tests
    "tparse@latest",
    // CI
    "act@latest",
    // For e2e tests
    "qemu_kvm@latest",
    "cdrkit@latest", // For genisoimage
    "harmonia@latest",
    "age@latest", // Encrypts the age secret fixture
    "sops@latest", // Encrypts the sops secret fixture
    // For benchmark graphing
    "python313",
    "python313Packages.matplotlib",
    "python313Packages.numpy",
    "python313Packages.pandas",
  ],
  "env": {
    "DEVBOX_NO_PROMPT": "true",
    "PANIX_CONFIG":     "examples/panix.deploy.yml",
    "CGO_ENABLED":      "0",
  },
  "shell": {
    "init_hook": [
      // Git hook installation only makes sense in an interactive shell; CI
      // also runs the init hook (devbox run) where stdout is not a TTY.
      "if [ -t 1 ]; then pre-commit install; fi",
    ],
    "scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1",
      ],
    },
  },
}
