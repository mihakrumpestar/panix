---
import LandingSection from "./LandingSection.astro";
import IconNote from "./IconNote.astro";
import type { Capability, ToolColumn } from "../lib/comparison";
import { TONE_RANK, cellTexts } from "../lib/comparison";

// Tone: good = capability present, warn = limited or a cost, off = absent,
// neutral = a model difference, not a quality. Fact set verified 2026-09-15
// against each tool's official repo/docs. Every cell links to the page that
// proves it: the feature's doc section where present, the closest matching
// section (where the capability would live) when it is absent.
//
// Row rules, kept here so future cell edits stay consistent:
// - Visibility gradient: good = purpose-built interactive surface (TUI,
//   Web UI); warn = polled or aggregate surface (status report, exporter);
//   off = nothing beyond the command's own output.
// - Health means service-level checks after activation. Activation failure
//   and SSH liveness don't count; a rollback trigger is not a health check.
// - Config changes asks what must change in your flake or configs. Fleet
//   descriptor files beside your configs (panix.yml, krops.nix, nixops.nix)
//   don't count; required dependencies like disko don't either.
// - TONE_RANK linearizes the 2-axis tone system as good < warn < neutral <
//   off: neutral below warn is deliberate (matches the legend order), so
//   dropdowns list limited values above equally-valid models.

// nixos-rebuild / nixos-install / system.autoUpgrade
const NIXOS_REBUILD_MANUAL =
  "https://nixos.org/manual/nixos/stable/#sec-changing-config";
const NIXOS_REBUILD_ROLLBACK =
  "https://nixos.org/manual/nixos/stable/#sec-rollback";
