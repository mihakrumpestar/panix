// Capability rows, with the distinct filterable values per row. Cells with
// item lists contribute every item, so each is filterable on its own.
const capabilityKeys = [
  { key: "bootstrap", label: "Bootstrap" },
  { key: "update", label: "Ongoing updates" },
  { key: "scope", label: "Scope" },
  { key: "visibility", label: "Visibility" },
  { key: "health", label: "Health checks" },
  { key: "rollback", label: "Rollback" },
  { key: "execution", label: "Execution" },
  { key: "state", label: "State" },
  { key: "flake", label: "Config changes" },
  { key: "secrets", label: "Secrets" },
];
const capabilities: Capability[] = capabilityKeys.map(({ key, label }) => {
  const bestRankByValue = new Map<string, number>();
  for (const tool of tools) {
    const cell = tool.cells[key];
    if (!cell) continue;
    const rank =
      "items" in cell
        ? Math.min(...cell.items.map((item) => TONE_RANK[item.tone]))
        : TONE_RANK[cell.tone];
    for (const text of cellTexts(cell)) {
      bestRankByValue.set(
        text,
        Math.min(bestRankByValue.get(text) ?? rank, rank),
      );
    }
  }
  const filterableValues = [...bestRankByValue.entries()]
    .sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]))
    .map(([value]) => value);
  return { key, label, values: filterableValues };
});

const toolsDataJson = JSON.stringify(
  tools.map((tool) => ({
    name: tool.name,
    href: tool.href,
    highlight: !!tool.highlight,
    cells: tool.cells,
  })),
);
const toolNamesJson = JSON.stringify(tools.map((tool) => tool.name));

// Plain-language definitions for every table term: shown as the cell-link
// hover tooltip and repeated in the glossary below the table.
const TERM_NOTES: Record<string, string> = {
  Yes: "Supported by the tool itself",
  No: "Not supported by the tool itself",
  Cloud: "Bootstraps by provisioning cloud instances (EC2, GCE, VirtualBox)",
  Fleet: "Deploys multiple machines from one config in one run",
  "Multi-flake": "A fleet can span multiple flakes and repos in one run",
  Single: "One machine per invocation",
  "Per-host":
    "Each host fetches and applies its own config from a shared source",
  TUI: "Interactive terminal UI with live per-machine, per-phase progress",
  "Web UI": "Browser dashboard for managing devices",
  Progress: "Live per-node progress display while deploying",
  Status: "Per-host status table (e.g. bento status)",
  Metrics: "Prometheus exporter and desktop notifiers",
  "CLI output": "The deployment command's own output; nothing else",
  None: "No built-in support in the tool itself",
  "On-target": "You run it on the machine being changed",
  "On-demand":
    "A check command exists, but it is not run automatically after deploy",
  Auto: "Rolls back automatically on activation failure",
  Magic:
    "Rolls back when the target loses contact with the deployment source after switching",
  Manual: "Explicit rollback command only",
  Push: "Deploys from your machine to targets over SSH",
  Pull: "Targets fetch updates themselves on a schedule",
  Controller:
    "A central server actively orchestrates the devices, which connect to it",
  Stateless: "No state kept between runs; everything is re-derived",
  Stateful: "Keeps a state database or vars that later deploys depend on",
  Unchanged: "Your existing configs are consumed as-is; nothing is wired in",
  Adapter:
    "The tool needs a module, output, or import wired into your flake or configs",
  Rewrite: "Your configs must be rebuilt around the tool's own format",
  Bypass: "Secrets are transferred outside the Nix store to arbitrary paths",
  Keys: "Materialized as key files via a keys API (default /run/keys, in-memory; destDir can target persistent paths)",
  Encrypted: "Encrypted in the store, decrypted at activation",
  "Install-phase": "Secrets are only handled during the install phase",
};

// What each capability row measures.
const CAP_NOTES: Record<string, string> = {
  bootstrap: "Can it install NixOS onto a fresh or non-NixOS machine?",
  update: "Does it support repeated, ongoing deployments?",
  scope: "What does one deployment action cover?",
  visibility:
    "Beyond the command's own output, how do you watch deployment progress?",
  health:
    "Are services verified after activation? Activation failure and SSH liveness don't count.",
  rollback:
    "How can the tool itself revert a failed deploy? (NixOS-native rollback, e.g. the boot menu, still exists where a NixOS system does.)",
  execution:
    "Who drives the deployment: your machine, the targets, or a server?",
  state: "What does the tool remember between runs?",
  flake:
    "Must the tool itself be wired into your flake or config (module, output, import)? Fleet descriptor files beside your configs (panix.yml, krops.nix, nixops.nix) don't count; required dependencies like disko don't either",
  secrets: "How are secrets delivered to machines?",
};

// Build-time guard: every cell text must have a TERM_NOTES definition and
// every TERM_NOTES entry must be used by some cell. Keeps the tooltips,
// glossary, and filter dropdowns from drifting apart; a throw here fails
// the docs build instead of shipping a termless cell.
{
  const termKeys = new Set(Object.keys(TERM_NOTES));
  const used = new Set<string>();
  for (const tool of tools) {
    for (const cell of Object.values(tool.cells)) {
      if ("items" in cell) {
        for (const item of cell.items) used.add(item.text);
      } else if (cell.text) {
        used.add(cell.text);
      }
    }
  }
  const missing = [...used].filter((term) => !termKeys.has(term));
  const orphan = [...termKeys].filter((term) => !used.has(term));
  if (missing.length || orphan.length) {
    throw new Error(
      `TERM_NOTES out of sync: missing [${missing.join(", ")}]; orphan [${orphan.join(", ")}]`,
    );
  }
}
