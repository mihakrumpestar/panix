<LandingSection
  kicker="comparison"
  title="How Panix compares"
  id="comparison"
>
  <div
    class="filters"
    data-compare-filters
    data-tools={toolsDataJson}
    data-tool-names={toolNamesJson}
  >
    <div class="filter-group" role="group" aria-label="Toggle tool columns">
      {
        tools.map((tool) =>
          tool.highlight ? (
            <span class="chip pin" title="Comparison baseline, always shown">
              {tool.name}
            </span>
          ) : (
            <button
              type="button"
              class="chip"
              data-tool-btn={tool.name}
              aria-pressed="true"
            >
              {tool.name}
            </button>
          ),
        )
      }
      <button type="button" class="chip reset" data-reset>Reset</button>
    </div>
    <div class="legend" aria-hidden="true">
      <span class="legend-item"><i class="sw sw-good"></i>present</span>
      <span class="legend-item"
        ><i class="sw sw-warn"></i>limited or a cost</span
      >
      <span class="legend-item"
        ><i class="sw sw-neutral"></i>different model</span
      >
      <span class="legend-item"><i class="sw sw-off"></i>absent</span>
    </div>
  </div>
  <div class="scroll" data-compare-scroll>
    <table data-compare-table>
      <thead>
        <tr>
          <th scope="col" class="rowhead">Capability</th>
          {
            tools.map((tool) => (
              <th
                scope="col"
                class:list={[{ hl: tool.highlight }]}
                data-tool={tool.name}
                title={
                  tool.highlight ? undefined : "Click to compare beside Panix"
                }
              >
                <span class="head-with-note">
                  {tool.href ? (
                    <a
                      class="tool-link"
                      href={tool.href}
                      target="_blank"
                      rel="noopener"
                    >
                      {tool.name}
                    </a>
                  ) : (
                    tool.name
                  )}
                  {tool.notice && <IconNote title={tool.notice} />}
                </span>
                {GITHUB_REPOS[tool.name] && (
                  <span
                    class="repo-meta pending"
                    data-repo={GITHUB_REPOS[tool.name]}
                    aria-label="GitHub stars and age"
                  />
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          capabilities.map((capability) => (
            <tr data-cap={capability.key}>
              <th
                scope="row"
                class="rowhead"
                title="Click to sort tools by this capability"
              >
                <span class="row-head-inner">
                  <span class="row-label">{capability.label}</span>
                  <IconNote
                    title={CAP_NOTES[capability.key] ?? capability.label}
                  />
                  <select
                    class="row-filter"
                    data-row-filter={capability.key}
                    aria-label={`Filter by ${capability.label}`}
                  >
                    <option value="">All</option>
                    {capability.values.map((value) => (
                      <option value={value} title={TERM_NOTES[value]}>
                        {value}
                      </option>
                    ))}
                  </select>
                </span>
              </th>
              {tools.map((tool) => {
                const cell = tool.cells[capability.key];
                // Items carry their own tone classes (on the links);
                // single-value cells use the td tone as before.
                const cellTone = "items" in cell ? undefined : cell.tone;
                const cellClassName = [
                  tool.highlight ? "hl" : null,
                  cellTone ? `tone-${cellTone}` : null,
                ]
                  .filter(Boolean)
                  .join(" ");
                return (
                  <td data-tool={tool.name} class={cellClassName}>
                    {"items" in cell ? (
                      <span class="items">
                        {cell.items.map((item) => (
                          <span class="cell-with-note">
                            <a
                              class={`cell-link item tone-${item.tone}`}
                              href={item.href}
                              target="_blank"
                              rel="noopener"
                              title={TERM_NOTES[item.text]}
                            >
                              {item.text}
                            </a>
                            {item.note && <IconNote title={item.note} />}
                          </span>
                        ))}
                      </span>
                    ) : cell.href ? (
                      <span class="cell-with-note">
                        <a
                          class="cell-link"
                          href={cell.href}
                          target="_blank"
                          rel="noopener"
                          title={TERM_NOTES[cell.text]}
                        >
                          {cell.text}
                        </a>
                        {cell.note && <IconNote title={cell.note} />}
                      </span>
                    ) : (
                      cell.text
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="note">
    Every cell links to what verifies it: the feature's own doc section where
    one exists, otherwise the source file that enumerates the tool's commands
    or options, since a documentation page cannot state that something is
    missing. Hover a cell or term for its plain-language meaning. Verified
    2026-09-15.
  </p>
  <p class="note">
    Filter with the row dropdowns (multiple rows combine), toggle tools with the
    chips, click a tool header to move it beside Panix, click a capability name
    to sort tools by it. The filter state is shareable via the URL.
  </p>
  <details class="glossary">
    <summary>Term glossary</summary>
    <dl>
      {
        Object.entries(TERM_NOTES).map(([term, note]) => (
          <div class="gl">
            <dt>{term}</dt>
            <dd>{note}</dd>
          </div>
        ))
      }
    </dl>
  </details>
</LandingSection>

<script>
  import {
    constructTable,
    tableFeatures,
    createCoreRowModel,
    columnVisibilityFeature,
    columnOrderingFeature,
  } from "@tanstack/table-core";
  import { storeReactivityBindings } from "@tanstack/table-core/store-reactivity-bindings";
  import type { ToolColumn } from "../lib/comparison";
  import { TONE_RANK, cellTexts, parseJson } from "../lib/comparison";

  // Stable wire shape for filter state shared through URLs and localStorage.
  interface SerializedFilterState {
    hide?: string[];
    f?: Record<string, string>;
    order?: string[];
  }

  // Fields read from the GitHub repository endpoint.
  interface GitHubRepositoryResponse {
    stargazers_count: number;
    created_at: string;
  }

  const filtersRoot = document.querySelector<HTMLElement>(
    "[data-compare-filters]",
  );
  const tableElement = document.querySelector<HTMLTableElement>(
    "[data-compare-table]",
  );
  const scrollElement = document.querySelector<HTMLElement>(
    "[data-compare-scroll]",
  );

  if (filtersRoot && tableElement && scrollElement) {
    // Cell model parsed from the server-rendered data: a single value or
    // a list of items (each its own filterable link).
    const tools = parseJson<ToolColumn[]>(filtersRoot.dataset.tools, "tools");
    const toolNames = parseJson<string[]>(
      filtersRoot.dataset.toolNames,
      "tool names",
    );
    const toolsByName = new Map(tools.map((tool) => [tool.name, tool]));

    const FILTER_STORAGE_KEY = "panix-compare-filters-v4";

    // Default-hidden baseline cluster: the raw NixOS primitives plus
    // nixos-infect (third-party, lustration-based, removal scheduled in
    // NixOS 26.11). nixos-anywhere stays visible as the maintained
    // representative of the bootstrap primitives. One chip click away.
    const DEFAULT_HIDDEN_TOOL_NAMES = [
      "nixos-rebuild",
      "nixos-install",
      "system.autoUpgrade",
      "nixos-infect",
    ];

    // URL state wins over localStorage so shared links are exact.
    function readInitialFilterState(): {
      hiddenToolNames: string[];
      filters: Record<string, string>;
      columnOrder: string[];
    } {
      const urlParams = new URLSearchParams(location.search);
      const hasUrlFilterState = urlParams.has("hide") || urlParams.has("f");
      try {
        if (hasUrlFilterState) {
          return {
            hiddenToolNames: (urlParams.get("hide") ?? "")
              .split(",")
              .filter(Boolean),
            filters: Object.fromEntries(
              (urlParams.get("f") ?? "")
                .split(",")
                .filter(Boolean)
                .map((pair) => pair.split("=", 2) as [string, string]),
            ),
            columnOrder: [] as string[],
          };
        }
        const parsedState: unknown = JSON.parse(
          localStorage.getItem(FILTER_STORAGE_KEY) || "null",
        );
        const savedFilterState = parsedState as SerializedFilterState | null;
        if (savedFilterState) {
          return {
            hiddenToolNames: Array.isArray(savedFilterState.hide)
              ? savedFilterState.hide
              : DEFAULT_HIDDEN_TOOL_NAMES,
            filters:
              savedFilterState.f && typeof savedFilterState.f === "object"
                ? savedFilterState.f
                : {},
            columnOrder: Array.isArray(savedFilterState.order)
              ? savedFilterState.order
              : [],
          };
        }
      } catch {
        /* corrupted entry, fall back to defaults */
      }
      return {
        hiddenToolNames: DEFAULT_HIDDEN_TOOL_NAMES,
        filters: {},
        columnOrder: [],
      };
    }
    const initialFilterState = readInitialFilterState();

    const features = tableFeatures({
      coreReactivityFeature: storeReactivityBindings(),
      columnVisibilityFeature,
      columnOrderingFeature,
      coreRowModel: createCoreRowModel(),
    });

    // One column per tool; TanStack owns visibility (chips) and order
    // (sorting). Row filters are composed below and applied in render().
    const table = constructTable({
      features,
      data: tools,
      columns: toolNames.map((toolName) => ({
        id: toolName,
        header: toolName,
        accessorFn: () => toolName,
      })),
      getRowId: (row) => row.name,
      initialState: {
        columnVisibility: Object.fromEntries(
          initialFilterState.hiddenToolNames.map((toolName) => [
            toolName,
            false,
          ]),
        ),
        columnOrder: initialFilterState.columnOrder.filter((toolName) =>
          toolNames.includes(toolName),
        ),
      },
    });

    // Active per-capability value filters: { capabilityKey: value }.
    let rowFilters: Record<string, string> = initialFilterState.filters;

    function passesFilters(tool: ToolColumn) {
      for (const [capabilityKey, value] of Object.entries(rowFilters)) {
        if (!value) continue;
        const cell = tool.cells[capabilityKey];
        if (!cell || !cellTexts(cell).includes(value)) return false;
      }
      return true;
    }

    function visibleTools(): string[] {
      const columnVisibility = table.atoms.columnVisibility.get();
      const columnOrder = table.atoms.columnOrder.get();
      const orderedToolNames = columnOrder.length ? columnOrder : toolNames;
      return orderedToolNames.filter(
        (toolName) =>
          toolName === "Panix" ||
          (columnVisibility[toolName] !== false &&
            passesFilters(toolsByName.get(toolName)!)),
      );
    }

    function persistFilterState() {
      const columnVisibility = table.atoms.columnVisibility.get();
      const hiddenToolNames = toolNames.filter(
        (toolName) => columnVisibility[toolName] === false,
      );
      const filterEntries = Object.entries(rowFilters).filter(
        ([, value]) => value,
      );
      const columnOrder = table.atoms.columnOrder.get();
      const urlParams = new URLSearchParams();
      if (hiddenToolNames.length)
        urlParams.set("hide", hiddenToolNames.join(","));
      if (filterEntries.length)
        urlParams.set(
          "f",
          filterEntries
            .map(([filterKey, value]) => `${filterKey}=${value}`)
            .join(","),
        );
      history.replaceState(
        null,
        "",
        `${location.pathname}${urlParams.size ? `?${urlParams}` : ""}`,
      );
      try {
        localStorage.setItem(
          FILTER_STORAGE_KEY,
          JSON.stringify({
            hide: hiddenToolNames,
            f: Object.fromEntries(filterEntries),
            order: columnOrder,
          }),
        );
      } catch {
        /* storage unavailable, URL still carries state */
      }
    }

    const tableHeadRow = tableElement.tHead!.rows[0];
    const tableBodyRows = [...tableElement.tBodies[0].rows];

    function render() {
      const visibleToolNames = visibleTools();
      const visibleToolNameSet = new Set(visibleToolNames);

      // Physically reorder and hide tool columns, header first.
      for (const toolName of visibleToolNames) {
        const headerCell = tableHeadRow.querySelector<HTMLElement>(
          `th[data-tool="${CSS.escape(toolName)}"]`,
        );
        if (headerCell) tableHeadRow.appendChild(headerCell);
      }
      tableHeadRow
        .querySelectorAll<HTMLElement>("th[data-tool]")
        .forEach((headerCell) => {
          if (headerCell.dataset.tool !== "Panix")
            headerCell.hidden = !visibleToolNameSet.has(headerCell.dataset.tool!);
        });

      for (const tableRow of tableBodyRows) {
        for (const toolName of visibleToolNames) {
          const bodyCell = tableRow.querySelector<HTMLElement>(
            `td[data-tool="${CSS.escape(toolName)}"]`,
          );
          if (bodyCell) tableRow.appendChild(bodyCell);
        }
        tableRow
          .querySelectorAll<HTMLElement>("td[data-tool]")
          .forEach((bodyCell) => {
            if (bodyCell.dataset.tool !== "Panix")
              bodyCell.hidden = !visibleToolNameSet.has(bodyCell.dataset.tool!);
          });
      }

      filtersRoot
        .querySelectorAll<HTMLButtonElement>("[data-tool-btn]")
        .forEach((toolButton) => {
          toolButton.setAttribute(
            "aria-pressed",
            String(
              table.atoms.columnVisibility.get()[
                toolButton.dataset.toolBtn!
              ] !== false,
            ),
          );
        });
    }

    function onStateChange() {
      render();
      persistFilterState();
    }

    table.atoms.columnVisibility.subscribe(onStateChange);
    table.atoms.columnOrder.subscribe(onStateChange);

    // Tool chips toggle columns.
    filtersRoot.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.hasAttribute("data-reset")) {
        rowFilters = {};
        tableElement
          .querySelectorAll<HTMLSelectElement>("[data-row-filter]")
          .forEach((rowFilterSelect) => {
            rowFilterSelect.value = "";
          });
        // Reset restores the default view (primitives hidden).
        table.setColumnVisibility(
          Object.fromEntries(
            toolNames
              .filter((toolName) =>
                DEFAULT_HIDDEN_TOOL_NAMES.includes(toolName),
              )
              .map((toolName) => [toolName, false]),
          ),
        );
        table.setColumnOrder(toolNames);
        // Atoms may already hold these defaults, in which case no
        // subscription fires: repaint directly.
        render();
        persistFilterState();
        return;
      }
      const toolButton = target.closest<HTMLElement>("[data-tool-btn]");
      if (toolButton) {
        table.getColumn(toolButton.dataset.toolBtn!)!.toggleVisibility();
      }
    });

    // Row filter dropdowns (AND-composed across rows). The selects live
    // inside the table, so the listener goes on the table.
    tableElement.addEventListener("change", (event) => {
      const rowFilterSelect = event.target as HTMLSelectElement;
      if (rowFilterSelect.hasAttribute("data-row-filter")) {
        const capabilityKey = rowFilterSelect.dataset.rowFilter!;
        if (rowFilterSelect.value)
          rowFilters[capabilityKey] = rowFilterSelect.value;
        else delete rowFilters[capabilityKey];
        render();
        persistFilterState();
      }
    });

    // Click a tool header to move the column right after Panix.
    tableElement.tHead!.addEventListener("click", (event) => {
      const headerCell = (event.target as HTMLElement).closest<HTMLElement>(
        "th[data-tool]",
      );
      if (!headerCell || headerCell.dataset.tool === "Panix") return;
      if ((event.target as HTMLElement).closest("a")) return;
      const clickedToolName = headerCell.dataset.tool!;
      const remainingToolNames = visibleTools().filter(
        (toolName) => toolName !== clickedToolName && toolName !== "Panix",
      );
      table.setColumnOrder([
        "Panix",
        clickedToolName,
        ...remainingToolNames,
        ...hiddenToolNames(),
      ]);
    });

    // Click a capability row header to sort tools by that row's values.
    tableElement.tBodies[0].addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("select, a")) return;
      const tableRow = (event.target as HTMLElement).closest<HTMLElement>(
        "tr[data-cap]",
      );
      if (!tableRow) return;
      const capabilityKey = tableRow.dataset.cap!;
      const rankedToolNames = toolNames
        .filter((toolName) => toolName !== "Panix")
        .map((toolName) => {
          const cell = toolsByName.get(toolName)?.cells[capabilityKey];
          return {
            toolName,
            rank: cell
              ? "items" in cell
                ? Math.min(...cell.items.map((item) => TONE_RANK[item.tone]))
                : TONE_RANK[cell.tone]
              : 3,
            text: cell
              ? "items" in cell
                ? (cell.items[0]?.text ?? "")
                : cell.text
              : "",
          };
        })
        .sort(
          (a, b) =>
            a.rank - b.rank ||
            a.text.localeCompare(b.text) ||
            a.toolName.localeCompare(b.toolName),
        )
        .map((rankedTool) => rankedTool.toolName);
      table.setColumnOrder(["Panix", ...rankedToolNames]);
    });

    function hiddenToolNames() {
      const columnVisibility = table.atoms.columnVisibility.get();
      return toolNames.filter(
        (toolName) =>
          toolName !== "Panix" && columnVisibility[toolName] === false,
      );
    }

    // Reflect loaded row filters in the dropdowns.
    tableElement
      .querySelectorAll<HTMLSelectElement>("[data-row-filter]")
      .forEach((rowFilterSelect) => {
        rowFilterSelect.value =
          rowFilters[rowFilterSelect.dataset.rowFilter!] ?? "";
      });

    // Reserve vertical space from the full (unfiltered) SSR table so
    // filtering never changes the page layout.
    scrollElement.style.minHeight = `${Math.ceil(
      tableElement.getBoundingClientRect().height,
    )}px`;

    // Live GitHub stars + repo age in tool headers, cached 24h in
    // localStorage (stale-while-revalidate). Isolated: a failure here
    // must never break the table logic.
    function loadRepositoryMeta() {
      try {
        const repositoryMetaElements = [
          ...tableElement.querySelectorAll<HTMLSpanElement>("[data-repo]"),
        ];
        const repositoryMetaCache: Record<
          string,
          { stars: number; created: string; cachedAt: number }
        > = JSON.parse(localStorage.getItem("panix-compare-stars-v1") || "{}");
        const formatStarCount = (starCount: number) =>
          starCount >= 10000
            ? `${Math.round(starCount / 1000)}k`
            : starCount >= 1000
              ? `${(starCount / 1000).toFixed(1)}k`
              : `${starCount}`;
        const formatRepositoryAge = (createdAt: string) => {
          const repositoryAgeDays = Math.floor(
            (Date.now() - new Date(createdAt).getTime()) / 86400000,
          );
          if (repositoryAgeDays >= 365)
            return `${Math.floor(repositoryAgeDays / 365)}y`;
          if (repositoryAgeDays >= 30)
            return `${Math.floor(repositoryAgeDays / 30)}mo`;
          return `${repositoryAgeDays}d`;
        };
        const paintRepositoryMeta = (
          repositoryMetaElement: HTMLSpanElement,
          cacheEntry: { stars: number; created: string },
        ) => {
          repositoryMetaElement.textContent = `★ ${formatStarCount(cacheEntry.stars)} · ${formatRepositoryAge(cacheEntry.created)}`;
          repositoryMetaElement.classList.remove("pending");
        };
        const saveRepositoryMetaCache = () => {
          try {
            localStorage.setItem(
              "panix-compare-stars-v1",
              JSON.stringify(repositoryMetaCache),
            );
          } catch {
            /* storage unavailable, keep in-memory values */
          }
        };
        const fetchRepositoryMeta = (
          repositorySlug: string,
          repositoryMetaElement: HTMLSpanElement,
        ) =>
          fetch(`https://api.github.com/repos/${repositorySlug}`)
            .then((response) =>
              response.ok ? response.json() : Promise.reject(response),
            )
            .then((payload: unknown) => {
              const repositoryJson = payload as GitHubRepositoryResponse;
              repositoryMetaCache[repositorySlug] = {
                stars: repositoryJson.stargazers_count,
                created: repositoryJson.created_at,
                cachedAt: Date.now(),
              };
              saveRepositoryMetaCache();
              paintRepositoryMeta(
                repositoryMetaElement,
                repositoryMetaCache[repositorySlug],
              );
            })
            .catch(() => repositoryMetaElement.classList.remove("pending"));
        for (const repositoryMetaElement of repositoryMetaElements) {
          const repositorySlug = repositoryMetaElement.dataset.repo!;
          const cacheEntry = repositoryMetaCache[repositorySlug];
          if (cacheEntry && Date.now() - cacheEntry.cachedAt < 86400000)
            paintRepositoryMeta(repositoryMetaElement, cacheEntry);
          else {
            if (cacheEntry)
              paintRepositoryMeta(repositoryMetaElement, cacheEntry);
            fetchRepositoryMeta(repositorySlug, repositoryMetaElement);
          }
        }
      } catch {
        /* dead meta, table still works */
      }
    }
    loadRepositoryMeta();

    render();
  }
</script>

