---
import { LinkButton } from "@astrojs/starlight/components";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero-bleed landing-bleed">
	<div class="hero-grid hero-band">
		<div class="hero-copy">
			<p class="landing-kicker hero-anim d-1">Nix deployment orchestrator</p>
			<h1
				id="_top"
				data-page-title
				class="hero-title hero-anim d-2"
				set:html={title}
			/>
			{
				tagline && <p class="hero-tagline hero-anim d-3" set:html={tagline} />
			}
			{
				actions.length > 0 && (
					<div class="hero-actions hero-anim d-4">
						{actions.map(
							({
								attrs: { class: className, ...attrs } = {},
								icon,
								link: href,
								text,
								variant,
							}) => (
								<LinkButton
									{href}
									{variant}
									icon={icon?.name}
									class:list={[className]}
									{...attrs}
								>
									{text}
								</LinkButton>
							),
						)}
					</div>
				)
			}
		</div>
		<div class="hero-anim d-5">
			<figure class="term">
				<div class="term-bar" aria-hidden="true">
					<span class="dots">
						<span class="dot dot-r"></span>
						<span class="dot dot-o"></span>
						<span class="dot dot-g"></span>
					</span>
					<span class="term-title">panix deploy</span>
				</div>
				{/* Animated gif: loops in every browser, regardless of autoplay policies.
				    Not committed to git; fetched at build time by 'task docs:assets' into public/. */}
				<img
					src="/demo.gif"
					alt="Panix TUI demo"
					width="940"
					height="964"
					loading="eager"
					decoding="async"
				/>
			</figure>
		</div>
	</div>
</div>

<style>
	.hero-bleed {
		padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 6vw, 4.5rem);
	}

	/* The hero band is deliberately wider than the 67.5rem content column
	   the sections below use. Capped at the exact natural composition:
	   27rem text max + 5rem gap + 58.75rem native demo width. Below the
	   cap the band bleeds to the viewport edges minus the page pad. */
	.hero-band {
		width: 100%;
		max-width: 90.75rem;
		margin-inline: auto;
	}

	.hero-grid {
		display: grid;
		gap: clamp(2rem, 5vw, 3.5rem);
		grid-template-columns: 1fr;
		align-items: center;
	}

	/* Stacked default: centered copy, demo centered and height-capped. */
	.hero-copy {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, calc(1rem + 1vw), 1.5rem);
		text-align: center;
	}

	.hero-title {
		margin: 0;
		font-size: clamp(
			var(--sl-text-3xl),
			calc(0.25rem + 5vw),
			var(--sl-text-6xl)
		);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.hero-tagline {
		margin: 0;
		font-size: clamp(
			var(--sl-text-base),
			calc(0.0625rem + 2vw),
			var(--sl-text-xl)
		);
		line-height: 1.4;
		color: var(--sl-color-gray-2);
		/* Readable measure while the column is full band width. */
		max-width: 36rem;
		margin-inline: auto;
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		padding-top: 0.5rem;
		justify-content: center;
	}

	/* Demo framed as a terminal window. */
	.term {
		margin: 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--astro-code-background, var(--sl-color-gray-6));
		box-shadow: var(--sl-shadow-md);
		/* Hug the image, center it, never upscale past native width. */
		width: fit-content;
		max-width: min(100%, 58.75rem);
		margin-inline: auto;
	}

	.term-bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-gray-6);
	}

	.dots {
		display: flex;
		gap: 0.4rem;
	}

	.dot {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 9999px;
	}

	.dot-r {
		background: var(--sl-color-red);
	}

	.dot-o {
		background: var(--sl-color-orange);
	}

	.dot-g {
		background: var(--sl-color-green);
	}

	.term-title {
		grid-column: 2;
		font-family: var(--sl-font-mono, var(--sl-font-system-mono));
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-2);
	}

	.term img {
		display: block;
		width: auto;
		height: auto;
		max-width: 100%;
		/* Cap so the stacked demo leaves most of the viewport visible. */
		max-height: 80vh;
		max-height: 80svh;
	}

	/* Two columns once the viewport fits a roomy text column and the
	   demo side by side: copy left, demo filling the rest of the band. */
	@media (min-width: 75rem) {
		.hero-grid {
			grid-template-columns: minmax(24rem, 27rem) minmax(0, 1fr);
			gap: clamp(3rem, 6vw, 5rem);
		}

		.hero-copy {
			text-align: start;
		}

		.hero-tagline {
			max-width: none;
			margin-inline: 0;
		}

		.hero-actions {
			justify-content: flex-start;
		}

		.term {
			width: auto;
			margin-inline: 0;
		}

		.term img {
			width: 100%;
			max-height: none;
		}
	}

	/* One orchestrated entrance, staggered. */
	.hero-anim {
		animation: hero-rise 0.55s ease-out both;
	}

	.d-2 {
		animation-delay: 0.06s;
	}

	.d-3 {
		animation-delay: 0.12s;
	}

	.d-4 {
		animation-delay: 0.18s;
	}

	.d-5 {
		animation: hero-rise 0.7s 0.22s ease-out both;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-anim {
			animation: none;
		}
	}
</style>
